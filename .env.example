# Copy to .env.local to override the defaults. Nothing here is required for
# local development: `npm install && npm run dev` works without any env file.

# Secret used to sign the session cookie (HS256). Development falls back to a
# built-in, public default. Always set your own outside development:
#   openssl rand -base64 32
SESSION_SECRET=

# Where the SQLite database lives. Defaults to ./data/crm.db
# DB_PATH=./data/crm.db

# The session cookie is HTTPS-only in production builds. Set to "false" only to
# serve a production build over plain HTTP.
# COOKIE_SECURE=false
